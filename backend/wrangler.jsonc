{
  "name": "mailroost",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "kv_namespaces": [
    {
      "binding": "TOKENS",
      "id": "40211436f424442ba0281acc1c24b1c9"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
